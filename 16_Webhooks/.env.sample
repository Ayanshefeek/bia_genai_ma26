# OpenAI — optional for this practical
# Leave USE_MOCK_LLM=true for a zero-cost classroom run.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
USE_MOCK_LLM=true

# LangSmith — optional, not required for this practical
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls__your-key-here
LANGCHAIN_PROJECT=BIA_Webhooks_FastAPI_Triggers

# Local server
SERVER_URL=http://127.0.0.1:8000

# Webhook security
# For classroom simplicity, unsigned events are accepted by default.
# Set ACCEPT_UNSIGNED_EVENTS=false to require X-BIA-Signature.
WEBHOOK_SECRET=bia-demo-secret
ACCEPT_UNSIGNED_EVENTS=true
SIGN_EVENTS=true
