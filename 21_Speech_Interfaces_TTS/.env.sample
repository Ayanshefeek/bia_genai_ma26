# OpenAI — required for cloud STT, cloud TTS, and LLM responses
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

# ElevenLabs — optional, used for expressive TTS comparison
ELEVENLABS_API_KEY=your-elevenlabs-key-here
ELEVENLABS_VOICE_ID=your-voice-id-here
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Piper — optional local/free TTS path
# Download a .onnx voice model and matching .onnx.json config, then set these paths.
PIPER_MODEL_PATH=voices/en_US-lessac-medium.onnx
PIPER_CONFIG_PATH=voices/en_US-lessac-medium.onnx.json

# Local Whisper — optional local STT path
LOCAL_WHISPER_MODEL=base

# Demo behavior
MOCK_TRANSCRIPT=Can you explain in simple words how text to speech works for an AI assistant?
