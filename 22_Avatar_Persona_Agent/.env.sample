# OpenAI — required for real LLM, STT, and TTS calls
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# Classroom reliability
# Set to true to run without API calls. The backend returns mock text and synthetic audio.
MOCK_MODE=false

# Frontend/backend local development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional LangSmith tracing placeholder for trainers who want to extend this
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls__your-key-here
LANGCHAIN_PROJECT=BIA_Avatar_Persona_Agent
