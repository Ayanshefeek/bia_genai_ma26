# OpenAI — required for real model calls
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Classroom/no-cost mode
# Set true to run deterministic mock outputs without any API calls.
USE_MOCK_LLM=true

# LangSmith — optional, enables tracing when you integrate LangSmith later
# Current package saves local JSON traces by default.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=ls__your-key-here
LANGSMITH_PROJECT=BIA_Team_Research_Bot_Build
