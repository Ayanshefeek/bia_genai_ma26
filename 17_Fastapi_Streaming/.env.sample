# OpenAI — optional for live LLM streaming
# Leave APP_USE_MOCK_LLM=true to run the full classroom demo without an API key.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
APP_USE_MOCK_LLM=true

# Backend
APP_NAME=Streaming Productivity Assistant
DATABASE_PATH=data/productivity_assistant.sqlite3
FRONTEND_ORIGIN=http://localhost:5173
MOCK_TOKEN_DELAY_SECONDS=0.035

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000
